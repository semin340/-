class Bullet:
    def __init__(
        self, x, y, vx, vy, color,
        radius=7, ground=True, life=360,
        ax=0.0, ay=0.0
    ):
        self.x = float(x)
        self.y = float(y)
        self.vx = vx
        self.vy = vy
        self.ax = ax
        self.ay = ay
        self.color = color
        self.r = radius
        self.ground = ground
        self.life = life

    def update(self):
        self.vx += self.ax
        self.vy += self.ay
        self.x += self.vx
        self.y += self.vy
        self.life -= 1

    def draw(self):
        pygame.draw.circle(
            screen, self.color,
            (int(self.x), int(self.y)), self.r
        )
        pygame.draw.circle(
            screen, WHITE,
            (int(self.x - 2), int(self.y - 2)),
            max(1, self.r // 3)
        )

    def alive(self):
        return (
            self.life > 0
            and -40 < self.x < W + 40
            and -50 < self.y < H + 50
        )


class Shot:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.vy = -8
        self.r = 5

    def update(self):
        self.y += self.vy

    def draw(self):
        pygame.draw.circle(
            screen, CYAN,
            (int(self.x), int(self.y)), self.r
        )


