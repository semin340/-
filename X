def start_logic_round():
    global logic_round_active, logic_round_timer
    global logic_form_index, logic_boss_blue
    global logic_should_attack, logic_feedback

    logic_form_index = random.randrange(len(logic_forms))
    logic_boss_blue = random.choice([True, False])

    logic_should_attack = logic_form_index in (0, 3)

    logic_round_active = True
    logic_round_timer = LOGIC_TIME_LIMIT
    logic_feedback = ""


def finish_logic_round(correct, message):
    global logic_round_active, logic_cooldown
    global logic_feedback, logic_feedback_timer, boss_hp

    logic_round_active = False
    logic_cooldown = 210

    if correct:
        logic_feedback = message
        logic_feedback_timer = 75
        boss_hp -= 12
    else:
        logic_feedback = "오답! HP -1"
        logic_feedback_timer = 75
        damage_player()


