def add_bullet(
    x, y, angle, speed, color,
    radius=7, ground=True, life=360,
    ax=0.0, ay=0.0
):
    vx = math.cos(angle) * speed
    vy = math.sin(angle) * speed

    bullets.append(
        Bullet(
            x, y, vx, vy, color,
            radius, ground, life, ax, ay
        )
    )


def aim_angle(x1, y1, x2, y2):
    return math.atan2(y2 - y1, x2 - x1)


def fan_attack(count, spread, speed, color, ground=True):
    angle = aim_angle(400, 95, player.x, player.y)

    for i in range(count):
        a = angle + (i - (count - 1) / 2) * spread
        add_bullet(
            400, 95, a, speed, color,
            radius=7, ground=ground
        )


def ring_attack(count, speed, color, offset=0, ground=True):
    for i in range(count):
        a = math.tau * i / count + offset
        add_bullet(
            400, 95, a, speed, color,
            radius=7, ground=ground
        )


def aimed_attack(count, speed, color, ground=False):
    for _ in range(count):
        a = aim_angle(400, 95, player.x, player.y)
        a += random.uniform(-0.15, 0.15)
        add_bullet(
            400, 95, a, speed, color,
            radius=8, ground=ground
        )


def edge_attack(count, speed, color):
    for _ in range(count):
        y = random.randint(ARENA.top + 15, ARENA.bottom - 15)

        for x in (ARENA.left - 5, ARENA.right + 5):
            a = aim_angle(x, y, player.x, player.y)
            add_bullet(
                x, y, a, speed, color,
                radius=7, ground=True
            )


def rain_attack(count, color):
    for _ in range(count):
        x = random.randint(ARENA.left + 10, ARENA.right - 10)
        y = ARENA.top - random.randint(10, 130)

        add_bullet(
            x, y, math.pi / 2,
            random.uniform(3, 4), color,
            radius=7, ground=True
        )


