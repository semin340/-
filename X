class Player:
    def __init__(self):
        self.x = 400
        self.y = 440
        self.r = 10
        self.hp = 5

        self.jump = 0
        self.jump_time = 0
        self.jump_cooldown = 0

        self.invincible = 0
        self.hit_flash = 0
        self.shoot_cooldown = 0

    def update(self, keys):
        speed = 4

        dx = (
            int(keys[pygame.K_RIGHT] or keys[pygame.K_d])
            - int(keys[pygame.K_LEFT] or keys[pygame.K_a])
        )
        dy = (
            int(keys[pygame.K_DOWN] or keys[pygame.K_s])
            - int(keys[pygame.K_UP] or keys[pygame.K_w])
        )

        if dx and dy:
            dx *= 0.7071
            dy *= 0.7071

        self.x += dx * speed
        self.y += dy * speed

        self.x = max(
            ARENA.left + 14,
            min(ARENA.right - 14, self.x)
        )
        self.y = max(
            ARENA.top + 14,
            min(ARENA.bottom - 14, self.y)
        )

        if self.jump_cooldown > 0:
            self.jump_cooldown -= 1

        if self.invincible > 0:
            self.invincible -= 1

        if self.hit_flash > 0:
            self.hit_flash -= 1

        if self.shoot_cooldown > 0:
            self.shoot_cooldown -= 1

        if self.jump_time > 0:
            self.jump_time -= 1
            t = 1 - self.jump_time / 32
            self.jump = math.sin(t * math.pi) * 48
        else:
            self.jump = 0

    def do_jump(self):
        if self.jump_cooldown <= 0 and self.jump_time <= 0:
            self.jump_time = 32
            self.jump_cooldown = 48

    def draw(self):
        pygame.draw.ellipse(
            screen, (65, 55, 80),
            (self.x - 12, self.y - 5, 24, 10)
        )

        draw_y = int(self.y - self.jump)

        points = [
            (self.x, draw_y - 12),
            (self.x + 12, draw_y - 2),
            (self.x + 9, draw_y + 9),
            (self.x, draw_y + 14),
            (self.x - 9, draw_y + 9),
            (self.x - 12, draw_y - 2),
        ]

        # 피격 시 약 0.1초 동안 선명한 빨간색
        if self.hit_flash > 0:
            pygame.draw.polygon(screen, BRIGHT_RED, points)
            pygame.draw.polygon(screen, WHITE, points, 2)
        else:
            # 피격 후 무적 시간에는 깜빡이는 효과
            if self.invincible > 0 and (self.invincible // 4) % 2 == 0:
                return

            pygame.draw.polygon(screen, RED, points)

        pygame.draw.circle(
            screen, WHITE, (self.x - 3, draw_y), 2
        )
        pygame.draw.circle(
            screen, WHITE, (self.x + 3, draw_y), 2
        )


def damage_player():
    """플레이어가 피해를 받을 때 공통 처리."""
    global game_state

    if player.invincible > 0:
        return

    player.hp -= 1
    player.invincible = 75
    player.hit_flash = 6

    if player.hp <= 0:
        game_state = "lose"


