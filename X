def spawn_pattern():
    global pattern_index, current_pattern_name

    p = pattern_index
    left = ARENA.left + 8
    right = ARENA.right - 8
    top = ARENA.top + 8
    bottom = ARENA.bottom - 8

    # 1. 이차함수: 좌우에서 들어오는 교차 탄막
    if p == 0:
        current_pattern_name = "이차함수 | 포물선 교차"

        for side in (0, 1):
            for i in range(7):
                y = top + 20 + i * 52
                x = left if side == 0 else right
                vx = 2.3 if side == 0 else -2.3
                vy = -1.2 if i % 2 == 0 else 1.2

                bullets.append(
                    Bullet(
                        x, y, vx, vy,
                        CYAN if side == 0 else PURPLE,
                        radius=8,
                        ground=False,
                        ay=0.02 if i % 2 == 0 else -0.02
                    )
                )

    # 2. 일차함수: 좌우와 위쪽에서 들어오는 탄막
    elif p == 1:
        current_pattern_name = "일차함수 | 기울기 교차"

        for i in range(6):
            y = top + 20 + i * 62

            add_bullet(
                left, y, 0, 3.0,
                YELLOW, radius=7, ground=False
            )
            add_bullet(
                right, y, math.pi, 3.0,
                CYAN, radius=7, ground=False
            )

        for i in range(5):
            x = left + 45 + i * 130

            add_bullet(
                x, top, math.pi / 2 + 0.12,
                2.7, PURPLE, radius=7, ground=False
            )

    # 3. 원의 방정식: 다중 확산 링
    elif p == 2:
        current_pattern_name = "원의 방정식 | 다중 확산 링"

        cx = ARENA.centerx
        cy = ARENA.top + 18

        ring_settings = [
            (12, 1.9, 0.00, PURPLE),
            (12, 2.3, math.pi / 12, CYAN),
            (12, 2.7, math.pi / 6, YELLOW),
        ]

        for count, speed, offset, color in ring_settings:
            for i in range(count):
                angle = math.tau * i / count + offset

                add_bullet(
                    cx, cy, angle, speed, color,
                    radius=5, ground=False, life=360
                )

    # 4. 좌표와 거리: 여러 방향에서 조준 탄막
    elif p == 3:
        current_pattern_name = "좌표와 거리 | 다방향 추적"

        points = [
            (left, top),
            (right, top),
            (left, bottom),
            (right, bottom),
            (ARENA.centerx, top),
            (ARENA.centerx - 130, top),
            (ARENA.centerx + 130, top),
        ]

        for i, (x, y) in enumerate(points):
            a = aim_angle(x, y, player.x, player.y)
            a += -0.09 if i % 2 == 0 else 0.09

            add_bullet(
                x, y, a,
                2.7 + (i % 2) * 0.2,
                CYAN if i % 2 == 0 else YELLOW,
                radius=8, ground=False
            )

        fan_attack(
            5, 0.17, 2.5, PURPLE, ground=False
        )

    # 5. 점과 직선 사이의 거리: 평행 탄막
    elif p == 4:
        current_pattern_name = "점과 직선 사이의 거리 | 평행선"

        for lane in range(5):
            y = top + 25 + lane * 75

            for offset in (0, 18):
                add_bullet(
                    left, y + offset, -0.05, 2.9,
                    RED, radius=7, ground=False
                )
                add_bullet(
                    right, y + offset, math.pi + 0.05, 2.9,
                    ORANGE, radius=7, ground=False
                )

    # 6. 명제: 빽빽하지만 넓은 안전 통로가 있는 탄막
    elif p == 5:
        current_pattern_name = "명제 | 안전 통로 탄막"

        safe_width = 230
        margin = 15

        safe_left = random.randint(
            ARENA.left + margin,
            ARENA.right - margin - safe_width
        )
        safe_right = safe_left + safe_width

        bullet_spacing = 28
        bullet_radius = 7
        buffer = player.r + bullet_radius + 10

        for x in range(
            ARENA.left + 12,
            ARENA.right - 8,
            bullet_spacing
        ):
            if safe_left - buffer <= x <= safe_right + buffer:
                continue

            add_bullet(
                x,
                top,
                math.pi / 2,
                random.uniform(3.0, 3.6),
                GREEN if x < safe_left else RED,
                radius=bullet_radius,
                ground=False
            )

    # 7. 산술·기하평균: 좌우 탄막과 중앙 탄막
    elif p == 6:
        current_pattern_name = "산술·기하평균 | 균형 붕괴"

        for i in range(7):
            y = top + 20 + i * 50

            add_bullet(
                left, y, 0, 2.6 + i * 0.07,
                YELLOW, radius=7, ground=False
            )

            add_bullet(
                right, y, math.pi, 3.1 - i * 0.06,
                CYAN, radius=7, ground=False
            )

        for i in range(4):
            y = top + 45 + i * 90

            add_bullet(
                ARENA.centerx - 45, y,
                math.pi / 2 + 0.22, 2.4,
                WHITE, radius=7, ground=False
            )

            add_bullet(
                ARENA.centerx + 45, y,
                math.pi / 2 - 0.22, 2.4,
                PURPLE, radius=7, ground=False
            )

    # 8. 합성함수: 휘어지는 탄환 파동
    else:
        current_pattern_name = "합성함수 | 차원 파동"

        for i in range(7):
            x = left + 30 + i * 90
            direction = 1 if i % 2 == 0 else -1

            bullets.append(
                Bullet(
                    x, top,
                    direction * 0.38, 2.6,
                    PURPLE if i % 2 == 0 else CYAN,
                    radius=8,
                    ground=False,
                    ax=-0.02 if i % 2 == 0 else 0.02
                )
            )

            bullets.append(
                Bullet(
                    x, bottom,
                    -direction * 0.38, -2.6,
                    YELLOW if i % 2 == 0 else RED,
                    radius=8,
                    ground=False,
                    ax=0.02 if i % 2 == 0 else -0.02
                )
            )

    pattern_index = (pattern_index + 1) % 8


