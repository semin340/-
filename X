running = True

while running:
    clock.tick(60)

    if screen_mode == "playing":
        frame += 1

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
            continue

        # 규칙 화면
        if screen_mode == "rules":
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False

                elif event.key in (
                    pygame.K_RETURN, pygame.K_KP_ENTER
                ):
                    player_name = ""
                    student_id = ""
                    active_input = "name"

                    screen_mode = "input"
                    input_mode = True
                    pygame.key.start_text_input()
            continue

        # 이름 및 학번 입력
        if input_mode:
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False

                elif event.key in (
                    pygame.K_RETURN, pygame.K_KP_ENTER
                ):
                    if player_name.strip() and student_id.strip():
                        input_mode = False
                        screen_mode = "playing"
                        pygame.key.stop_text_input()
                        reset_game()

                elif event.key == pygame.K_BACKSPACE:
                    if active_input == "name":
                        player_name = player_name[:-1]
                    else:
                        student_id = student_id[:-1]

                elif event.key in (
                    pygame.K_TAB, pygame.K_UP, pygame.K_DOWN
                ):
                    active_input = (
                        "student_id" if active_input == "name"
                        else "name"
                    )

            elif event.type == pygame.TEXTINPUT:
                if active_input == "name" and len(player_name) < 10:
                    player_name += event.text

                elif active_input == "student_id" and len(student_id) < 15:
                    if event.text.isdigit():
                        student_id += event.text

            elif (
                event.type == pygame.MOUSEBUTTONDOWN
                and event.button == 1
            ):
                if name_box_rect.collidepoint(event.pos):
                    active_input = "name"
                elif id_box_rect.collidepoint(event.pos):
                    active_input = "student_id"

            continue

        # 게임 중 키 입력
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False

            elif game_state == "playing":
                if event.key == pygame.K_SPACE:
                    player.do_jump()

                elif event.key == pygame.K_e:
                    if logic_round_active:
                        if logic_should_attack:
                            finish_logic_round(
                                True, "정답! 공격 성공"
                            )
                        else:
                            finish_logic_round(False, "")
                    elif player.shoot_cooldown <= 0:
                        shots.append(
                            Shot(player.x, player.y - player.jump)
                        )
                        player.shoot_cooldown = 12

            elif event.key in (
                pygame.K_RETURN, pygame.K_KP_ENTER
            ):
                screen_mode = "rules"
                input_mode = False
                pygame.key.stop_text_input()

    if not running:
        break

    if screen_mode == "rules":
        draw_rules_screen()
        pygame.display.flip()
        continue

    if input_mode:
        draw_input_screen()
        pygame.display.flip()
        continue

    # =========================
    # 게임 진행
    # =========================
    if game_state == "playing":
        keys = pygame.key.get_pressed()
        player.update(keys)

        if logic_feedback_timer > 0:
            logic_feedback_timer -= 1

        if logic_round_active:
            logic_round_timer -= 1

            if logic_round_timer <= 0:
                if logic_should_attack:
                    finish_logic_round(False, "")
                else:
                    finish_logic_round(
                        True, "정답! 공격 금지 성공"
                    )
        else:
            logic_cooldown -= 1

            if logic_cooldown <= 0:
                start_logic_round()

        # 패턴 간격: 기본 약 3초
        pattern_timer += 1
        interval = max(
            95,
            int(180 / BOSSES[boss_index]["speed"])
        )

        if pattern_timer >= interval:
            pattern_timer = 0
            spawn_pattern()

        # 레이저 갱신
        if laser_timer > 0:
            laser_timer -= 1

        if laser_timer <= 0:
            laser_x = None

        # 플레이어 공격탄
        for shot in shots[:]:
            shot.update()

            if shot.y < 0:
                shots.remove(shot)
                continue

            if math.hypot(shot.x - 400, shot.y - 85) < 32:
                shots.remove(shot)
                boss_hp -= 4

        # 보스 처치 확인
        if boss_hp <= 0:
            game_state = "win"

        # 적 탄환과 충돌
        for bullet in bullets[:]:
            bullet.update()

            if not bullet.alive():
                bullets.remove(bullet)
                continue

            # 지상 탄환은 점프 중 회피
            if bullet.ground and player.jump_time > 0:
                continue

            distance = math.hypot(
                bullet.x - player.x,
                bullet.y - (player.y - player.jump)
            )

            if distance < bullet.r + player.r:
                bullets.remove(bullet)
                damage_player()

                if game_state != "playing":
                    break

        # 레이저 충돌
        if (
            game_state == "playing"
            and laser_x is not None
            and laser_timer <= 18
            and abs(player.x - laser_x) < 10
        ):
            damage_player()

    # =========================
    # 점수 및 랭킹 저장
    # =========================
    if game_state in ("win", "lose") and not score_saved:
        final_survival_time = max(
            0.0,
            (pygame.time.get_ticks() - game_start_ticks) / 1000
        )
        final_survival_time = round(final_survival_time, 1)

        survival_bonus = max(0, 6000 - frame * 2)
        hp_bonus = max(0, player.hp) * 500
        win_bonus = 3000 if game_state == "win" else 0

        final_score = survival_bonus + hp_bonus + win_bonus
        result_text = "승리" if game_state == "win" else "게임 오버"

        existing = next(
            (
                row for row in leaderboard
                if str(row.get("name", "")) == player_name
                and str(row.get("student_id", "")) == student_id
            ),
            None
        )

        if existing is None:
            leaderboard.append({
                "name": player_name,
                "student_id": student_id,
                "score": int(final_score),
                "survival_time": final_survival_time,
                "result": result_text,
            })
        else:
            old_time = float(existing.get("survival_time", 0))

            if final_survival_time > old_time:
                existing["survival_time"] = final_survival_time
                existing["score"] = int(final_score)
                existing["result"] = result_text

        leaderboard.sort(
            key=lambda row: float(row.get("survival_time", 0)),
            reverse=True
        )
        leaderboard = leaderboard[:100]

        try:
            LEADERBOARD_FILE.write_text(
                json.dumps(
                    leaderboard, ensure_ascii=False, indent=2
                ),
                encoding="utf-8"
            )
        except OSError:
            pass

        score_saved = True

    # =========================
    # 화면 렌더링
    # =========================
    draw_arena()
    draw_laser()

    for bullet in bullets:
        bullet.draw()

    for shot in shots:
        shot.draw()

    player.draw()

    draw_text(
        "이동: 방향키/WASD  점프: SPACE  공격: E",
        100, 555, CYAN, SMALL_FONT
    )

    if game_state in ("win", "lose"):
        draw_result_screen()

    pygame.display.flip()

pygame.quit()
