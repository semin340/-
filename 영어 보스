    pygame.draw.rect(screen, (65, 30, 45), (100, 48, 600, 16))
    pygame.draw.rect(
        screen, BOSS["color"],
        (100, 48, max(0, int(600 * boss_hp / boss_max_hp)), 16)
    )

    draw_text("HP", 100, 72, RED)

    for i in range(5):
        color = RED if i < player.hp else (65, 35, 45)
        pygame.draw.rect(screen, color, (140 + i * 27, 77, 20, 10))

    shown_pattern = pattern_index + 1
    if shown_pattern > PATTERN_COUNT:
        shown_pattern = 1

    draw_text(
        f"PATTERN {shown_pattern}/{PATTERN_COUNT}",
        520, 73, YELLOW
    )
    draw_text(current_pattern_name, 100, 115, CYAN, SMALL)

    # =========================
    # 퀴즈 패널 + 가로형 타이머 바
    # =========================
    if quiz_active and quiz_word:
        panel = pygame.Rect(190, 175, 420, 255)

        pygame.draw.rect(
            screen, (27, 25, 48), panel, border_radius=12
        )
        pygame.draw.rect(
            screen, YELLOW, panel, 3, border_radius=12
        )

        draw_text("VOCABULARY CHALLENGE", 245, 190, YELLOW, SMALL)
        draw_text(quiz_word[0], 310, 220, CYAN, WORD_FONT)
        draw_text(
            "뜻을 선택하세요! (1 / 2 / 3 / 4)",
            240, 260, WHITE, SMALL
        )

        for i, meaning in enumerate(quiz_choices):
            draw_text(
                f"{i + 1}. {meaning}",
                260, 290 + i * 29, WHITE, SMALL
            )

        # 막대 타이머: 전투 공간과 동일한 가로 길이
        bar_x = ARENA.left
        bar_y = ARENA.bottom + 10
        bar_w = ARENA.width
        bar_h = 12

        time_ratio = max(
            0.0,
            min(1.0, quiz_timer / QUIZ_TIME_MAX)
        )
        remaining_w = int(bar_w * time_ratio)

        if time_ratio > 0.5:
            bar_color = GREEN
        elif time_ratio > 0.2:
            bar_color = ORANGE
        else:
            bar_color = RED

        pygame.draw.rect(
            screen, (55, 30, 45),
            (bar_x, bar_y, bar_w, bar_h)
        )

        if remaining_w > 0:
            pygame.draw.rect(
