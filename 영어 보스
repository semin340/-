class Shot:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.vy = -8
        self.r = 5

    def update(self):
        self.y += self.vy

    def draw(self):
        pygame.draw.circle(
            screen, CYAN,
            (int(self.x), int(self.y)),
            self.r
        )


