        )

    for gy in range(ARENA.top + 30, ARENA.bottom, 30):
        pygame.draw.line(
            screen, (32, 35, 65),
            (ARENA.left, gy), (ARENA.right, gy)
        )

    pygame.draw.rect(screen, WHITE, ARENA, 3)

    pulse = math.sin(frame * 0.06) * 4
    bx, by = 400, 95

    pygame.draw.circle(
