# 게임 재시작
# =========================
def restart_game():
    global player, bullets, shots
    global boss_hp, frame, pattern_timer, pattern_index
    global current_pattern_name, game_state
    global quiz_active, quiz_timer, quiz_cooldown
    global quiz_feedback, quiz_feedback_timer
    global quiz_word, quiz_choices, quiz_answer

    player = Player()
    bullets = []
    shots = []
    boss_hp = BOSS["hp"]

    frame = 0
    pattern_timer = 0
    pattern_index = 0
    current_pattern_name = "VOCABULARY TEST"

    quiz_active = False
    quiz_timer = 0
    quiz_cooldown = 100
    quiz_feedback = ""
    quiz_feedback_timer = 0
    quiz_word = None
    quiz_choices = []
    quiz_answer = 0
    game_state = "playing"


# =========================
# 메인 루프
# =========================
running = True

while running:
    clock.tick(60)
    frame += 1

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False

            if game_state == "playing":
                if event.key == pygame.K_SPACE:
                    player.do_jump()

                if quiz_active:
                    key_map = {
                        pygame.K_1: 0,
                        pygame.K_2: 1,
                        pygame.K_3: 2,
                        pygame.K_4: 3,
                        pygame.K_KP1: 0,
                        pygame.K_KP2: 1,
                        pygame.K_KP3: 2,
                        pygame.K_KP4: 3,
                    }

                    if event.key in key_map:
                        finish_quiz(key_map[event.key] == quiz_answer)

                elif event.key == pygame.K_u:
                    if player.shoot_cooldown <= 0:
                        shots.append(Shot(player.x, player.y - player.jump))
                        player.shoot_cooldown = 12

            elif event.key == pygame.K_RETURN:
                restart_game()

    if game_state == "playing":
        keys = pygame.key.get_pressed()
        player.update(keys)

        if quiz_feedback_timer > 0:
            quiz_feedback_timer -= 1

        if quiz_active:
            quiz_timer -= 1
            if quiz_timer <= 0:
                finish_quiz(False)
        else:
            quiz_cooldown -= 1
            if quiz_cooldown <= 0:
                start_quiz()

        pattern_timer += 1
        interval = max(65, int(150 / BOSS["speed"]))

        if pattern_timer >= interval:
            pattern_timer = 0
            spawn_pattern()

        for shot in shots[:]:
            shot.update()

            if shot.y < 0:
                shots.remove(shot)
                continue

            if math.hypot(shot.x - BOSS_X, shot.y - BOSS_Y) < 43:
                shots.remove(shot)
                boss_hp -= 4

        if boss_hp <= 0:
            boss_hp = 0
            game_state = "win"

        for bullet in bullets[:]:
            bullet.update()

            if not bullet.alive():
                bullets.remove(bullet)
                continue

            if bullet.ground and player.jump_time > 0:
                continue

            distance = math.hypot(
                bullet.x - player.x,
                bullet.y - (player.y - player.jump)
            )

            if distance < bullet.r + player.r:
                bullets.remove(bullet)

                if player.invincible <= 0:
                    player.hp -= 1
                    player.invincible = 75

                    if player.hp <= 0:
                        player.hp = 0
                        game_state = "lose"

    # =========================
    # 렌더링
    # =========================
    draw_arena()

    for bullet in bullets:
        bullet.draw()

    for shot in shots:
        shot.draw()

    player.draw()

    draw_text(
        "MOVE: WASD/ARROWS   JUMP: SPACE   ATTACK: U",
        120, 720, CYAN, SMALL
    )
    draw_text(
        "QUIZ: 1-4 / NUMPAD 1-4",
        120, 750, YELLOW, SMALL
    )

    if game_state == "win":
        screen.fill(BLACK)
        draw_text("ENGLISH MASTER DEFEATED!", 320, 275, YELLOW, BIG)
        draw_text("You conquered the English challenge!", 330, 350, CYAN, FONT)
        draw_text("ENTER: RESTART     ESC: QUIT", 370, 425, WHITE, FONT)

    elif game_state == "lose":
        screen.fill(BLACK)
        draw_text("GAME OVER", 490, 275, RED, BIG)
        draw_text("Study hard and try again!", 430, 350, WHITE, FONT)
        draw_text("ENTER: RETRY     ESC: QUIT", 420, 425, WHITE, FONT)

    # 내부 화면을 실제 모니터 전체에 맞춰 출력
    scaled_screen = pygame.transform.scale(screen, (DISPLAY_W, DISPLAY_H))
    display.blit(scaled_screen, (0, 0))
    pygame.display.flip()

pygame.quit()
