# =========================
# 탄막 생성 도구
# =========================
def add_bullet(
    x, y, angle, speed, color,
    radius=7, ground=False, ax=0, ay=0
):
    vx = math.cos(angle) * speed
    vy = math.sin(angle) * speed

    bullets.append(
        Bullet(
            x, y, vx, vy, color,
            radius, ground, 360, ax, ay
        )
    )


def aim_angle(x1, y1, x2, y2):
    return math.atan2(y2 - y1, x2 - x1)


def add_word_bullet(x, y, angle, speed, word=None, color=None):
    if word is None:
        word = random.choice(WORDS)[0]

    if color is None:
        color = random.choice([CYAN, PURPLE, PINK, ORANGE])

    bullets.append(
        WordBullet(
            x, y,
            math.cos(angle) * speed,
            math.sin(angle) * speed,
            word,
            color
        )
    )


# =========================
# 보스 패턴 13종
# =========================
def spawn_pattern():
    global pattern_index, current_pattern_name

    p = pattern_index

    left = ARENA.left + 10
    right = ARENA.right - 10
    top = ARENA.top + 10
    bottom = ARENA.bottom - 10

    boss_x, boss_y = 400, 95

    if p == 0:
        current_pattern_name = "ALPHABET RAIN"

        for _ in range(20):
            x = random.randint(left, right)
            y = random.randint(top - 100, top)
            add_bullet(
                x, y, math.pi / 2,
                random.uniform(3.0, 4.5),
                CYAN, radius=7
            )

    elif p == 1:
        current_pattern_name = "GRAMMAR CROSS"

        for i in range(8):
            y = top + i * 42
            add_bullet(left, y, 0, 3.5, YELLOW, radius=8)
            add_bullet(right, y, math.pi, 3.5, PURPLE, radius=8)

    elif p == 2:
        current_pattern_name = "ASGORE LETTER RING"

        letters = ["A", "E", "R", "S", "T", "O", "N"]
        ring_count = 7
        letters_per_ring = 4

        for ring in range(ring_count):
            base_angle = math.pi / 2 + ring * math.tau / ring_count
            offset = math.pi / 18 if ring % 2 else 0

            for j in range(letters_per_ring):
                spread = (j - (letters_per_ring - 1) / 2) * 0.12
                angle = base_angle + offset + spread
                word = random.choice(letters)
                color = ORANGE if ring % 2 == 0 else PINK
                speed = 3.0 + (j % 2) * 0.4
                add_word_bullet(
                    boss_x, boss_y, angle, speed, word, color
                )

    elif p == 3:
        current_pattern_name = "PUNCTUATION STORM"

        for i in range(6):
            x = left + i * 106
            add_bullet(
                x, top, math.pi / 2 + 0.15,
                4.0, RED, radius=8
            )
            add_bullet(
                right - i * 106, bottom,
                -math.pi / 2 - 0.15,
                4.0, GREEN, radius=8
            )

    elif p == 4:
        current_pattern_name = "SENTENCE WAVE"

        for i in range(11):
            y = top + i * 31
            direction = 1 if i % 2 == 0 else -1
            bullets.append(
                Bullet(
                    left if direction == 1 else right,
                    y, direction * 3.0, 0,
                    CYAN if direction == 1 else PURPLE,
                    radius=7,
                    ax=0, ay=math.sin(i) * 0.035
                )
            )

    elif p == 5:
        current_pattern_name = "WISDOM SOUL"

        source_y = ARENA.centery
        left_x = ARENA.left + 28
        right_x = ARENA.right - 28

        for i in range(4):
            spread = (i - 1.5) * 0.16
            speed = 3.2 + (i % 2) * 0.4

            left_angle = (
                aim_angle(left_x, source_y, player.x, player.y)
                + spread
            )
            add_word_bullet(
                left_x, source_y, left_angle, speed, color=PURPLE
            )

            right_angle = (
                aim_angle(right_x, source_y, player.x, player.y)
                - spread
            )
            add_word_bullet(
                right_x, source_y, right_angle, speed, color=CYAN
            )

    elif p == 6:
        current_pattern_name = "SYNONYM SPIRAL"

        cx, cy = 400, 175

        for i in range(16):
            angle = math.tau * i / 16 + frame * 0.035
            add_bullet(cx, cy, angle, 2.8, GREEN, radius=7)

    elif p == 7:
        current_pattern_name = "FINAL EXAM"

        for i in range(9):
            x = left + i * 72
            direction = 1 if i % 2 == 0 else -1

            bullets.append(
                Bullet(
                    x, top, direction * 1.1, 3.2,
                    ORANGE, radius=8, ax=-direction * 0.025
                )
            )
            bullets.append(
                Bullet(
                    x, bottom, -direction * 1.1, -3.2,
                    CYAN, radius=8, ax=direction * 0.025
                )
            )

    elif p == 8:
        current_pattern_name = "FAN SHOT"

        count = 9
        center_angle = aim_angle(
            boss_x, boss_y, player.x, player.y
        )
        spread = math.radians(58)

        for i in range(count):
            angle = (
                center_angle - spread / 2
                + spread * i / (count - 1)
            )
            add_bullet(
                boss_x, boss_y, angle, 3.4,
                ORANGE, radius=8
            )

    elif p == 9:
        current_pattern_name = "ZIGZAG DANCE"

        for i in range(8):
            y = top + i * 43
            direction = 1 if i % 2 == 0 else -1
            start_x = left if direction == 1 else right

            bullets.append(
                Bullet(
                    start_x, y, direction * 3.5, 0,
                    PINK if direction == 1 else CYAN,
                    radius=8,
                    ay=0.045 if i % 2 == 0 else -0.045
                )
            )

    elif p == 10:
        current_pattern_name = "TARGET BURST"

        base_angle = aim_angle(
            boss_x, boss_y, player.x, player.y - player.jump
        )

        for offset in [-0.18, 0, 0.18]:
            add_bullet(
                boss_x, boss_y, base_angle + offset,
                4.0, RED, radius=8
            )

    elif p == 11:
        current_pattern_name = "ROTATING CROSS"

        cx, cy = 400, 175
        count = 8

        for i in range(count):
            angle = math.tau * i / count + frame * 0.045
            add_bullet(
                cx, cy, angle, 3.0,
                PURPLE if i % 2 == 0 else CYAN,
                radius=8
            )

    else:
        current_pattern_name = "DOUBLE ARC"

        for i in range(6):
            y = 190 + i * 48
            bullets.append(
                Bullet(
                    left, y, 3.0, -0.15 + i * 0.055,
                    YELLOW, radius=8, ax=0, ay=0.025
                )
            )
            bullets.append(
                Bullet(
                    right, y, -3.0, 0.15 - i * 0.055,
                    GREEN, radius=8, ax=0, ay=-0.025
                )
            )

    pattern_index = (pattern_index + 1) % PATTERN_COUNT


