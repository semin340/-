class Player:
    def __init__(self):
        self.x = 400
        self.y = 440
        self.r = 10
        self.hp = 5
        self.jump = 0
        self.jump_time = 0
        self.jump_cooldown = 0
        self.invincible = 0
        self.shoot_cooldown = 0

    def update(self, keys):
        speed = 4

        dx = (
            int(keys[pygame.K_RIGHT] or keys[pygame.K_d])
            - int(keys[pygame.K_LEFT] or keys[pygame.K_a])
        )
        dy = (
            int(keys[pygame.K_DOWN] or keys[pygame.K_s])
            - int(keys[pygame.K_UP] or keys[pygame.K_w])
        )

        self.x += dx * speed
        self.y += dy * speed

        self.x = max(
            ARENA.left + 14,
            min(ARENA.right - 14, self.x)
        )
        self.y = max(
            ARENA.top + 14,
            min(ARENA.bottom - 14, self.y)
        )

        if self.jump_cooldown > 0:
            self.jump_cooldown -= 1

        if self.invincible > 0:
            self.invincible -= 1

        if self.shoot_cooldown > 0:
            self.shoot_cooldown -= 1

        if self.jump_time > 0:
            self.jump_time -= 1
            t = 1 - self.jump_time / 32
            self.jump = math.sin(t * math.pi) * 48
        else:
            self.jump = 0

    def do_jump(self):
        if self.jump_cooldown <= 0 and self.jump_time <= 0:
            self.jump_time = 32
            self.jump_cooldown = 48

    def draw(self):
        pygame.draw.ellipse(
            screen,
            (65, 55, 80),
            (self.x - 12, self.y - 5, 24, 10)
        )

        draw_y = int(self.y - self.jump)

        if self.invincible > 0 and (self.invincible // 4) % 2 == 0:
            return

        points = [
            (self.x, draw_y - 12),
            (self.x + 12, draw_y - 2),
            (self.x + 9, draw_y + 9),
            (self.x, draw_y + 14),
            (self.x - 9, draw_y + 9),
            (self.x - 12, draw_y - 2),
        ]

        pygame.draw.polygon(screen, RED, points)
        pygame.draw.circle(screen, WHITE, (self.x - 3, draw_y), 2)
        pygame.draw.circle(screen, WHITE, (self.x + 3, draw_y), 2)


# =========================
# 일반 탄환
# =========================
class Bullet:
    def __init__(
        self, x, y, vx, vy, color,
        radius=7, ground=False, life=360, ax=0, ay=0
    ):
        self.x = float(x)
        self.y = float(y)
        self.vx = vx
        self.vy = vy
        self.ax = ax
        self.ay = ay
        self.color = color
        self.r = radius
        self.ground = ground
        self.life = life

    def update(self):
        self.vx += self.ax
        self.vy += self.ay
        self.x += self.vx
        self.y += self.vy
        self.life -= 1

    def draw(self):
        pygame.draw.circle(
            screen,
            self.color,
            (int(self.x), int(self.y)),
            self.r
        )
        pygame.draw.circle(
            screen,
            WHITE,
            (int(self.x - 2), int(self.y - 2)),
            max(1, self.r // 3)
        )

    def alive(self):
        return (
            self.life > 0
            and -50 < self.x < W + 50
            and -60 < self.y < H + 60
        )


# =========================
# 글자 탄환
# =========================
class WordBullet(Bullet):
    def __init__(self, x, y, vx, vy, word, color):
        super().__init__(
            x, y, vx, vy, color,
            radius=9,
            ground=False,
            life=300
        )
        self.word = word

    def draw(self):
        image = WORD_BULLET_FONT.render(
            self.word, True, self.color
        )
        rect = image.get_rect(
            center=(int(self.x), int(self.y))
        )
        screen.blit(image, rect)


# =========================
# 플레이어 공격
