class Shot:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.vy = -10
        self.r = 6

    def update(self):
        self.y += self.vy

    def draw(self):
        pygame.draw.circle(
            screen, CYAN,
            (int(self.x), int(self.y)), self.r
        )
        pygame.draw.circle(
            screen, WHITE,
            (int(self.x), int(self.y)), 2
        )


