import pygame
import sys

# 1. 초기화
pygame.init()

# 2. 화면 설정 (1920 x 1080 FHD)
SCREEN_WIDTH = 1920
SCREEN_HEIGHT = 1080
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("언더테일 스타일 회피 게임 (1920x1080)")

# 3. 시계 설정 (프레임 제어)
clock = pygame.time.Clock()

# 4. 색상 정의 (RGB)
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
PINK = (255, 105, 180)
RED = (255, 50, 50)

# 5. 폰트 설정 (해상도가 커졌으므로 폰트 크기도 키움: 50포인트)
try:
    font = pygame.font.SysFont("malgungothic", 50)
except:
    font = pygame.font.SysFont(None, 50)

# 6. 회피 박스 설정 (1920x1080 화면 크기에 맞게 중앙으로 배치하고 키움)
box_width = 900
box_height = 450
box_x = (SCREEN_WIDTH - box_width) // 2   # 화면 정중앙 X
box_y = (SCREEN_HEIGHT - box_height) // 2 # 화면 정중앙 Y
box_thickness = 8  # 테두리 두께도 살짝 키움

# 7. 플레이어(핑크 네모) 설정
player_size = 40  # 네모 크기 확대
player_x = box_x + box_width // 2 - player_size // 2
player_y = box_y + box_height // 2 - player_size // 2
player_speed = 8  # 화면이 커져서 이동 속도도 살짝 상향 (기존 4 -> 8)

# 8. 게임 상태 변수 (체력, 타이머)
max_hp = 100
current_hp = 100
elapsed_time = 0.0  # 0초부터 점점 올라가는 타이머 변수

# 9. 게임 메인 루프
while True:
    # 9-1. Delta Time 계산 (초 단위)
    dt = clock.tick(60) / 1000.0  

    # 9-2. 이벤트 처리 (창 닫기)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    # 9-3. 타이머 증가 (0초부터 점점 올라가도록 수정)
    elapsed_time += dt

    # 9-4. 키보드 입력 처리 (WASD)
    keys = pygame.key.get_pressed()
    if keys[pygame.K_w]:
        player_y -= player_speed
    if keys[pygame.K_s]:
        player_y += player_speed
    if keys[pygame.K_a]:
        player_x -= player_speed
    if keys[pygame.K_d]:
        player_x += player_speed

    # 9-5. 플레이어가 박스 밖으로 나가지 못하게 제한 (충돌 처리)
    if player_x < box_x + box_thickness:
        player_x = box_x + box_thickness
    if player_x + player_size > box_x + box_width - box_thickness:
        player_x = box_x + box_width - box_thickness - player_size
    if player_y < box_y + box_thickness:
        player_y = box_y + box_thickness
    if player_y + player_size > box_y + box_height - box_thickness:
        player_y = box_y + box_height - box_thickness - player_size

    # 9-6. 화면을 검은색으로 채우기
    screen.fill(BLACK)

    # 9-7. 언더테일 박스 그리기
    # 테두리 박스
    pygame.draw.rect(screen, WHITE, (box_x, box_y, box_width, box_height), box_thickness)
    # 박스 안쪽 배경 (검은색)
    pygame.draw.rect(screen, BLACK, (box_x + box_thickness, box_y + box_thickness, 
                                     box_width - (box_thickness * 2), box_height - (box_thickness * 2)))

    # 9-8. 핑크색 네모(플레이어) 그리기
    pygame.draw.rect(screen, PINK, (player_x, player_y, player_size, player_size))

    # 9-9. UI 텍스트 그리기 (해상도에 맞게 위치와 크기 조정)
    # 체력 표시 (박스 아래쪽)
    hp_text = font.render(f"HP : {int(current_hp)} / {max_hp}", True, WHITE)
    screen.blit(hp_text, (box_x, box_y + box_height + 30))

    # 타이머 표시 (0초부터 올라감, 박스 위쪽)
    time_text = font.render(f"TIME : {elapsed_time:.1f}s", True, WHITE)
    screen.blit(time_text, (box_x, box_y - 70))

    # 9-10. 화면 업데이트
    pygame.display.flip()
